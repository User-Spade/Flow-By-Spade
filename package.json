{
  "name": "flow-by-spade",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "validate:data": "node scripts/validate-database.js",
    "fix:transitions": "node scripts/fix-transition-symmetry.js --write",
    "add:positions:bottom": "node scripts/add-positions.js --write",
    "fill:belts": "node scripts/fill-belt-content.js --write",
    "add:full-mount": "node scripts/add-full-mount-expansion.js",
    "add:kob": "node scripts/add-knee-on-belly-expansion.js",
    "add:rear-mount": "node scripts/add-rear-mount-expansion.js",
    "add:side-control": "node scripts/add-side-control-expansion.js",
    "update:copy": "node scripts/update-position-copy.js --write",
    "curate:belts": "node scripts/rebuild-belt-content.js --write",
    "gen:descriptions": "node scripts/generate-descriptions.js --write",
    "apply:descriptions": "npm run gen:descriptions && npm run update:copy && npm run curate:belts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.25",
    "expo-constants": "^18.0.10",
    "expo-font": "~14.0.9",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.15",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/styled-components": "^5.1.35",
    "@types/styled-components-react-native": "^5.2.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
